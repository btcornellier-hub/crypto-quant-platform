{
  "$comment": "PAPER TRADING CONFIG. dry_run must stay true until the owner approves live trading in docs/DECISION_LOG.md. API keys are NEVER stored in this file; they go in a separate private file on the server.",
  "bot_name": "trend-two-sleeve-v2",
  "dry_run": true,
  "dry_run_wallet": 5000,
  "stake_currency": "USD",
  "stake_amount": "unlimited",
